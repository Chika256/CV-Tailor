{
  "manifest_version": 3,
  "name": "CV Tailor Capture",
  "version": "1.4.0",
  "description": "Capture job listings for CV tailoring and autofill application forms using the local CV Tailor companion.",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Send job to CV Tailor",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
